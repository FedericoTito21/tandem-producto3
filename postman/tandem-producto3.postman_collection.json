              "host": [
                "{{url}}"
              ]
            },
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation($id: ID!) { deseleccionarIntercambio(id: $id) { id seleccionado } }",
                "variables": "{\n  \"id\": \"{{intercambioId}}\"\n}"
              }
            }
          }
        }
      ]
    },
    {
      "name": "5. Datos de demo",
      "item": [
        {
          "name": "iniciarDatosDemo",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{url}}",
              "host": [
                "{{url}}"
              ]
            },
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation { cargarDatosDemo { usuariosCreados intercambiosCreados } }",
                "variables": "{}"
              }
            }
          }
        }
      ]
    }
  ]
}
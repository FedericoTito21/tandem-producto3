            "url": {
              "raw": "{{url}}",
              "host": [
                "{{url}}"
              ]
            },
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation($id: ID!) { seleccionarIntercambio(id: $id) { id titulo seleccionado } }",
                "variables": "{\n  \"id\": \"{{intercambioId}}\"\n}"
              }
            }
          }
        },
        {
          "name": "obtenerSeleccionados",
          "request": {
            "method": "POST",

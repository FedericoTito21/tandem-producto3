# Copia este fichero a ".env" y ajusta los valores.
PORT=4000

# --- MongoDB: SOLO UNA de las dos líneas (la otra comentada) ---
# En local (o contenedor Docker de docker-compose.yml):
MONGODB_URI=mongodb://localhost:27017
# En MongoDB Atlas (CodeSandbox): sustituye usuario, contraseña y cluster
# MONGODB_URI=mongodb+srv://USUARIO:CONTRASENA@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=tandem

# --- Seguridad ---
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio
JWT_EXPIRA=2h
# Administrador que se crea al arrancar si no existe
ADMIN_EMAIL=admin@tandem.com
ADMIN_PASSWORD=admin1234
